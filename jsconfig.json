{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "/core/*": ["core/*"],
      "/domains/*": ["domains/*"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["app.js", "core/**/*.js", "domains/**/*.js"],
  "exclude": ["domains/operation/runtime.js"]
}
